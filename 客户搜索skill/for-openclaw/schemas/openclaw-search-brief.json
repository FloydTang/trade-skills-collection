{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenClaw Search Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_or_offer",
    "target_market",
    "customer_type",
    "search_keywords"
  ],
  "properties": {
    "product_or_offer": { "type": "string" },
    "target_market": { "type": "string" },
    "customer_type": { "type": "string" },
    "search_keywords": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "must_include": {
      "type": "array",
      "items": { "type": "string" }
    },
    "exclude_terms": {
      "type": "array",
      "items": { "type": "string" }
    },
    "max_results": { "type": "integer" },
    "notes": { "type": "string" },
    "fixtures_json": { "type": "string" },
    "data_sources": {
      "type": "array",
      "description": "用户授权提供的数据源，如海关数据导出、展会名单、行业协会名单、企业 CRM/Excel 或历史成交数据。",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "source_type": { "type": "string" },
          "source_name": { "type": "string" },
          "authorization_status": { "type": "string" },
          "input_format": { "type": "string" },
          "source_url_or_note": { "type": "string" },
          "field_mapping": { "type": "object" },
          "records": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      }
    }
  }
}
