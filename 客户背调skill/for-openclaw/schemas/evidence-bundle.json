{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TradeCustomerIntelEvidenceBundle",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "search_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "query": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "snippet": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    "page_snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    "search_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "stage": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "result_count": {
            "type": "integer"
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "stage": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "evidence_items": {
      "type": "array",
      "description": "可选的结构化证据。每条证据可携带事实、推断或假设主张，供 SIEGER v2 建立 claim_id 到 evidence_id 的映射。",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string" },
          "source_type": { "type": "string" },
          "source_quality": {
            "type": "string",
            "enum": ["primary", "strong_secondary", "secondary", "weak"]
          },
          "observed_at_or_period": { "type": "string" },
          "retrieved_at": { "type": "string" },
          "freshness": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "note": { "type": "string" },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["statement", "category", "statement_type", "confidence"],
              "properties": {
                "statement": { "type": "string" },
                "category": { "type": "string" },
                "statement_type": { "type": "string", "enum": ["fact", "inference", "hypothesis"] },
                "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
                "observed_at_or_period": { "type": "string" },
                "dimension": { "type": "string" },
                "rating": { "type": "integer", "minimum": 1, "maximum": 5 }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "search_results",
    "page_snapshots",
    "search_runs",
    "errors"
  ]
}
