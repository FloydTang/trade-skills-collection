{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trade Customer Intel Input v2",
  "type": "object",
  "additionalProperties": false,
  "anyOf": [
    {
      "required": ["company_name"],
      "properties": { "company_name": { "type": "string", "minLength": 1 } }
    },
    {
      "required": ["person_name"],
      "properties": { "person_name": { "type": "string", "minLength": 1 } }
    },
    {
      "required": ["email"],
      "properties": { "email": { "type": "string", "minLength": 1 } }
    }
  ],
  "properties": {
    "company_name": { "type": "string" },
    "person_name": { "type": "string" },
    "email": { "type": "string" },
    "company_website": { "type": "string" },
    "country_or_market": { "type": "string" },
    "product_or_offer": { "type": "string" },
    "industry_lens": {
      "type": "string",
      "enum": ["auto", "industrial", "food", "consumer", "general"]
    },
    "seller_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "company_name": { "type": "string" },
        "product_or_offer": { "type": "string" },
        "product_categories": { "type": "array", "items": { "type": "string" } },
        "target_customer_types": { "type": "array", "items": { "type": "string" } },
        "target_industries": { "type": "array", "items": { "type": "string" } },
        "value_propositions": { "type": "array", "items": { "type": "string" } },
        "certifications": { "type": "array", "items": { "type": "string" } },
        "proof_points": { "type": "array", "items": { "type": "string" } },
        "authorized_materials": { "type": "array", "items": { "type": "string" } },
        "excluded_customer_signals": { "type": "array", "items": { "type": "string" } },
        "forbidden_claims": { "type": "array", "items": { "type": "string" } }
      }
    },
    "screening_context": { "type": "object" },
    "notes": { "type": "string" }
  }
}
