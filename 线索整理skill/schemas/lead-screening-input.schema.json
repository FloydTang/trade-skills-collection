{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lead Screening Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["leads"],
  "properties": {
    "default_country_or_market": {
      "type": "string"
    },
    "operator_notes": {
      "type": "string"
    },
    "product_or_offer": { "type": "string" },
    "target_customer_type": { "type": "string" },
    "industry_lens": {
      "type": "string",
      "enum": ["auto", "industrial", "food", "consumer", "general"]
    },
    "seller_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "company_name": { "type": "string" },
        "product_or_offer": { "type": "string" },
        "product_categories": { "type": "array", "items": { "type": "string" } },
        "target_customer_types": { "type": "array", "items": { "type": "string" } },
        "target_industries": { "type": "array", "items": { "type": "string" } },
        "value_propositions": { "type": "array", "items": { "type": "string" } },
        "certifications": { "type": "array", "items": { "type": "string" } },
        "proof_points": { "type": "array", "items": { "type": "string" } },
        "authorized_materials": { "type": "array", "items": { "type": "string" } },
        "excluded_customer_signals": { "type": "array", "items": { "type": "string" } },
        "forbidden_claims": { "type": "array", "items": { "type": "string" } }
      }
    },
    "leads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "company_name": { "type": "string" },
          "company_website": { "type": "string" },
          "person_name": { "type": "string" },
          "email": { "type": "string" },
          "country_or_market": { "type": "string" },
          "source_url": { "type": "string" },
          "linkedin_url": { "type": "string" },
          "notes": { "type": "string" },
          "product_keywords": { "type": "string" },
          "source_type": { "type": "string" },
          "source_name": { "type": "string" },
          "source_url_or_note": { "type": "string" },
          "freshness": { "type": "string" },
          "confidence": { "type": "string" },
          "match_basis": { "type": "string" }
          ,"evidence_grade": { "type": "string" }
          ,"match_reason": { "type": "string" }
          ,"evidence_summary": { "type": "string" }
          ,"discovery_missing_fields": { "type": "array", "items": { "type": "string" } }
          ,"discovery_next_action": { "type": "string" }
        }
      }
    }
  }
}
